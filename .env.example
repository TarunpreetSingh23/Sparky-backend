# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/sparky_production

# JWT secrets
JWT_SECRET=supersecretjwtauthtokenforthesparkyapplicationatleast32chars
JWT_REFRESH_SECRET=supersecretjwtrefreshtokenforthesparkyapplicationatleast32chars

# Razorpay credentials
RAZORPAY_KEY_ID=rzp_test_dummykeyid
RAZORPAY_KEY_SECRET=dummykeysecretforrazorpayintegration
RAZORPAY_WEBHOOK_SECRET=dummywebhooksecretforrazorpaysignatures

# Google Maps API key
GOOGLE_MAPS_API_KEY=AIzaSyDummyMapsAPIKeyForGeospatialResolutions

# Cloudinary media configurations
CLOUDINARY_CLOUD_NAME=sparky-dummy-cloud
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=dummycloudinarysecretkeyforuploads

# MSG91 SMS gateway details
MSG91_AUTH_KEY=123456dummyauthkeymsg91
MSG91_TEMPLATE_ID=123456dummytemplateidmsg91
MSG91_SENDER_ID=SPARKY

# Firebase service account for push notifications
FIREBASE_PROJECT_ID=sparky-dummy-fcm
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@sparky-dummy-fcm.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC3\nDummyFirebasePrivateKeyHere\n-----END PRIVATE KEY-----\n"

# Resend email API configuration
RESEND_API_KEY=re_dummyresendkeyforemaildispatches
EMAIL_FROM=noreply@sparky.in

# Meta WhatsApp Business Cloud API configurations
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v19.0

# Mock Mode (set to true to test bot logic locally without sending Meta HTTP requests)
MOCK_WHATSAPP=false
